### Тесты для апи на основе базового сида
@host = http://localhost:8080/api
@orgSet  = 6d12ca92-e5ba-4808-946e-17b207765a72
@cppSet  = 104d6ef5-2d2b-451b-9ae4-07ec047600f5
@geoSet  = a782a18c-b664-41c6-8a8c-9842393d3f4f

### ---------- Health ----------
GET {{host}}/health

### ---------- Homescreen ----------
# Ждём user.id=0, sets: 3 шт
GET {{host}}//

###
GET {{host}}/feed

### ---------- Sets ----------
GET {{host}}/sets/{{geoSet}}

### shareCode 238472
GET {{host}}/sets/{{geoSet}}/share

### 4 факта
GET {{host}}/sets/{{geoSet}}/plan

### автор -> 200
GET {{host}}/sets/{{geoSet}}/leaderboard

### не автор -> 403
GET {{host}}/sets/{{orgSet}}/leaderboard

### ОРГ Лекция по разделу 4
GET {{host}}/sets/{{orgSet}}

### Этапы обработки кода программы на C++_ пространства имён и локали
GET {{host}}/sets/{{cppSet}}

###
GET {{host}}/sets/{{orgSet}}/cards

### 404: несуществующий набор
GET {{host}}/sets/00000000-0000-4000-8000-000000000000

### ---------- Join ----------
### 200 (набор "ОРГ Лекция по разделу 4")
POST {{host}}/sets/join
Content-Type: application/json

{ "code": "298788" }

### повторный join
POST {{host}}/sets/join
Content-Type: application/json

{ "code": "298788" }

### 404: кода нет
POST {{host}}/sets/join
Content-Type: application/json

{ "code": "000000" }

### 400: не 6 цифр
POST {{host}}/sets/join
Content-Type: application/json

{ "code": "12ab" }

### ---------- Answer ----------
# Засчитывается карточка из ленты, включая раннее повторение. Повтор запроса
# с тем же attemptId возвращает записанный вердикт; для нового повторения
# нужен новый attemptId. input — текст, choice — JSON-массив
# выбранных вариантов, boolean и flip — true/false, table — JSON-массив
# {text, column}.
# d6b86b0d… «Республика»
### верно
POST {{host}}/cards/d6b86b0d-e286-4396-93f2-93aaa55816af/answer
Content-Type: application/json

{ "answer": "Республика", "attemptId": "01900000-0000-7000-8000-000000000001" }

### верно с опечаткой/регистром
POST {{host}}/cards/d6b86b0d-e286-4396-93f2-93aaa55816af/answer
Content-Type: application/json

{ "answer": "республика ", "attemptId": "01900000-0000-7000-8000-000000000002" }

### неверно
POST {{host}}/cards/d6b86b0d-e286-4396-93f2-93aaa55816af/answer
Content-Type: application/json

{ "answer": "монархия", "attemptId": "01900000-0000-7000-8000-000000000003" }

### 400: пустое тело
POST {{host}}/cards/d6b86b0d-e286-4396-93f2-93aaa55816af/answer
Content-Type: application/json

{}

### 404: карточки нет
POST {{host}}/cards/00000000-0000-4000-8000-000000000000/answer
Content-Type: application/json

{ "answer": "x", "attemptId": "01900000-0000-7000-8000-000000000004" }

### ---------- Reveal (только flip, до самооценки) ----------
POST {{host}}/cards/2a89de89-0bcb-47d8-adb1-b9a09e3e4991/reveal

### 400: не flip
POST {{host}}/cards/d6b86b0d-e286-4396-93f2-93aaa55816af/reveal

### ---------- Update card ----------
### 200: поменять объяснение
PUT {{host}}/cards/4e402054-b545-492c-9b57-edebdcd48d4b
Content-Type: application/json

{ "answer": false, "explanation": "Президент не может досрочно распустить парламент в смешанной республике." }

### 200: choice
PUT {{host}}/cards/4e402054-b545-492c-9b57-edebdcd48d4b
Content-Type: application/json

{ "options": ["6 лет", "4 года", "5 лет", "7 лет"], "answer": 0 }

### 400: неизвестный kind
PUT {{host}}/cards/4e402054-b545-492c-9b57-edebdcd48d4b
Content-Type: application/json

{ "kind": "unknown" }

### ---------- Delete (гонять в конце, деструктивно) ----------
### 204 набор геометрии (автор — user 0)
DELETE {{host}}/sets/{{geoSet}}

### 404 повторное удаление
DELETE {{host}}/cards/{{geoSet}}

### чужой набор — 204, пользователь отписывается от набора
DELETE {{host}}/sets/{{orgSet}}
