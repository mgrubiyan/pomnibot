# Production domain for Traefik routing
DOMAIN=pomnibot.steins.ru

# Local/host port
PORT=8080

# MAX Bot API token
BOT_TOKEN=

# Image settings for production deployments
DOCKER_IMAGE=ghcr.io/mgrubiyan/pomnibot
IMAGE_TAG=latest

# Deployment target directory on VPS (used in CI/CD)
DEPLOY_PATH=~/pomnibot

# GigaChat API credentials from the project settings: the Authorization Key,
# or Client ID and Client Secret (the key is base64 of "client_id:client_secret")
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Main model for card generation and the one used when it is out of quota or failing
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_FALLBACK_MODEL=GigaChat-2-Max
# Optional overrides; GigaChat-3-Ultra is served only by api.giga.chat
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Answer cap per model call, 4096 by default; raise it if answers come cut off
# GIGACHAT_MAX_TOKENS=4096

# Yandex Vision OCR for photos and scanned PDF pages: API key of a service
# account with the ai.vision.user role, and its folder
YC_API_KEY=
YC_FOLDER_ID=
# Optional OCR model for every page (handwritten, page...); empty: handwritten
# for photos, page for scans
YC_OCR_MODEL=
