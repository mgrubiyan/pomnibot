# Application environment: local (API + web, no integrations) or prod
APP_ENV=local

# ---------------- SECRETS ----------------
BOT_TOKEN=
# Optional Telegram BotFather token; bot disabled when unset or in local mode
TG_BOT_TOKEN=

# Required only in prod: fill in a real GigaChat credential.
# Set either GIGACHAT_AUTH_KEY, or both GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET.
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

YC_API_KEY=
YC_FOLDER_ID=

DATABASE_URL=postgres://pomnibot:pomnibot@localhost:5432/pomnibot?sslmode=disable
POSTGRES_PASSWORD=pomnibot
# ---------------- SECRETS ----------------

# Localhost port
PORT=8080

# Production domain for Traefik routing (used in CI/CD)
DOMAIN=pomnibot.pslu.ru

# MAX Bot
MAX_API_URL=https://platform-api2.max.ru
MAX_INSECURE_SKIP_VERIFY=false

# Image settings for production deployments
DOCKER_IMAGE=ghcr.io/mgrubiyan/pomnibot
IMAGE_TAG=latest

# Deployment target directory on VPS (used in CI/CD)
DEPLOY_PATH=~/pomnibot

# PostgreSQL Configuration
POSTGRES_USER=pomnibot
POSTGRES_DB=pomnibot
POSTGRES_PORT=5432

# GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Main model for card generation and the one used when it is out of quota or failing
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_FALLBACK_MODEL=GigaChat-2-Max
# Optional overrides; GigaChat-3-Ultra is served only by api.giga.chat
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Answer cap per model call, 8192 by default; raise it if answers come cut off
GIGACHAT_MAX_TOKENS=8192

# Yandex OCR
YC_OCR_BASE_URL=https://ai.api.cloud.yandex.net
YC_OCR_OPERATION_URL=https://operation.api.cloud.yandex.net

# Qwen on Yandex AI Studio writes the cards, grades answers and reads photos of
# notes; GigaChat is its backup. Uses YC_API_KEY and YC_FOLDER_ID; the service
# account also needs the ai.languageModels.user role. YC_LLM_MODEL=off runs on
# GigaChat alone.
YC_LLM_MODEL=qwen3.6-35b-a3b
YC_LLM_BASE_URL=https://ai.api.cloud.yandex.net
YC_LLM_MAX_TOKENS=8000
# Which model goes first: aistudio or gigachat
LLM_PRIMARY=aistudio
# How long one call to the first model may take before the other gets the
# request, and how long a model that is down gets no requests
LLM_PRIMARY_TIMEOUT=1m
LLM_COOLDOWN=10m

# Review Notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATION_TIME=10:00
NOTIFICATION_TZ=Europe/Moscow
